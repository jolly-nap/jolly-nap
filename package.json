	},
	"homepage": "https://github.com/jolly-nap/jolly-nap#readme",
	"scripts": {
		"check-types": "tsc --build .",
		"lint": "run-s lint:prettier:check lint:eslint:check",
		"lint:eslint:check": "eslint .",
		"lint:eslint:fix": "eslint --fix .",
		"lint:fix": "run-s lint:prettier:fix lint:eslint:fix",
		"lint:prettier": "eslint .",
		"lint:prettier:check": "prettier --cache --check -u .",
		"lint:prettier:fix": "prettier --cache --write -u .",
		"serve": "http-server -c-1 -p 8888"
	},
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@sister.software/eslint-config": "^8.0.1",
		"@sister.software/prettier-config": "^8.0.1",
		"@sister.software/tsconfig": "^8.0.1",
		"@types/node": "^25.6.0",
		"eslint": "^9.39.4",
		"eslint-plugin-headers": "^1.3.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^50.8.0",
		"eslint-plugin-lit": "^2.2.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.2",
		"prettier-plugin-jsdoc": "1.8.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"release-it": "^19.2.4",
		"type-fest": "^5.5.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2"
	},
	"prettier": "@sister.software/prettier-config",
	"overrides": {
		"@sister.software/prettier-config": {
			"prettier-plugin-packagejson": "$prettier-plugin-packagejson"
		}
	}
